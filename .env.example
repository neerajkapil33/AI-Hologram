# Copied to .env by start_windows.ps1 / setup — fill in real values there.
# .env itself is gitignored; never commit real keys.

APP_NAME=Neeraj Kapil Hologram

# Vite dev server origin, for CORS. Change if you run Vite on a different port.
FRONTEND_ORIGIN=http://localhost:5173

# --- Brain (brain.py) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Voice (tts.py) ---
# URL of an OpenAI-compatible TTS server (e.g. a self-hosted Chatterbox
# instance) that has been given neeraj-voice-reference.wav as its cloning
# reference. Leave blank to disable voice output (text-only replies).
TTS_URL=
TTS_VOICE=file:///voices/neeraj-voice-reference
TTS_LANGUAGE=en

# --- Speech-to-text (stt.py) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- Avatar video (avatar.py) ---
# "simple" = no generated video, just audio + the Three.js avatar's own
# blink/expression/gesture system driven by the frontend.
# "musetalk" = generate a lip-synced video per turn via a local MuseTalk
# install (run setup_musetalk.sh first, and point MUSETALK_DIR at it).
AVATAR_ENGINE=simple
MUSETALK_DIR=third_party/MuseTalk
