# Copied to .env by start_windows.ps1 / setup — fill in real values there.
# .env itself is gitignored; never commit real keys.

APP_NAME=Neeraj Kapil Hologram
FRONTEND_ORIGIN=http://localhost:5173
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000/ws

# --- Brain (brain.py) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Voice (tts.py) ---
TTS_URL=
TTS_VOICE=file:///voices/neeraj-voice-reference
TTS_LANGUAGE=en

# --- Speech-to-text (stt.py) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- Local avatar fallback (avatar.py) ---
AVATAR_ENGINE=simple
MUSETALK_DIR=third_party/MuseTalk
MUSETALK_SOURCE_VIDEO=assets_private/neeraj-reference.mp4
MUSETALK_AVATAR_ID=neeraj_ai
MUSETALK_TIMEOUT=180

# --- Production high-fidelity live video call (Tavus CVI) ---
# Current Tavus API uses Face + PAL IDs.
# Never expose TAVUS_API_KEY to Vite/browser code.
TAVUS_BASE_URL=https://tavusapi.com
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=
# Legacy aliases are accepted by backend/tavus.py during migration.
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
TAVUS_CUSTOM_GREETING=Hi, I’m Neeraj AI. What would you like to work on today?
TAVUS_CONVERSATIONAL_CONTEXT=You are Neeraj AI, an AI representation of Neeraj Kapil. Be warm, confident, empathetic, strategic and practical. Default to English, but naturally switch to the user's selected language. Focus on career strategy, leadership, talent acquisition, interviews, resumes, LinkedIn, job search, skills and global career opportunities. Never claim to be the physical Neeraj or invent private biography. Listen before advising, and be concise enough for spoken conversation.

# Optional future persistent memory layer; keep disabled until consent/inspect/delete UX is enabled.
MEMORY_ENABLED=false
