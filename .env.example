# Copy to .env and fill in real values. Never commit real keys.

APP_NAME=Neeraj Kapil Hologram
FRONTEND_ORIGIN=http://localhost:5173
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000/ws
VITE_BACKEND_HTTP_URL=

# --- Brain ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Realtime voice ---
# Configure a compatible TTS endpoint that returns audio for /v1/audio/speech.
TTS_URL=
TTS_VOICE=file:///voices/neeraj-voice-reference.wav
TTS_LANGUAGE=en-IN

# --- Optional RVC voice conversion ---
# RVC is an external/local service; leave disabled until its model and service exist.
RVC_ENABLED=false
RVC_URL=http://127.0.0.1:8020
RVC_MODEL=
RVC_INDEX=
RVC_INDEX_RATE=0.75
RVC_F0_METHOD=rmvpe
RVC_PITCH=0
RVC_PROTECT=0.33
RVC_TIMEOUT=180

# --- Whisper STT ---
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto

# --- Optional high-fidelity live video call (Tavus CVI) ---
TAVUS_BASE_URL=https://tavusapi.com
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
TAVUS_CUSTOM_GREETING=Hi, I’m Neeraj AI. What would you like to work on today?
TAVUS_CONVERSATIONAL_CONTEXT=You are Neeraj AI, an AI representation of Neeraj Kapil. Be warm, confident, empathetic, strategic and practical. Default to English, but naturally switch to the user's selected language. Focus on career strategy, leadership, talent acquisition, interviews, resumes, LinkedIn, job search, skills and global career opportunities. Never claim to be the physical Neeraj or invent private biography. Listen before advising, and be concise enough for spoken conversation.

# Optional persistent memory layer; keep disabled until consent/inspect/delete UX exists.
MEMORY_ENABLED=false
